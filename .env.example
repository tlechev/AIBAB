# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or real secrets.
# The values below are LOCAL DEVELOPMENT values only. The TEST_* values are the
# public, fixed defaults of the Supabase CLI's local stack (`npx supabase status`).

# Public URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Runtime database connection as the `aibab_app` role (server-only, master secret
# in hosted environments — see docs/ARCHITECTURE.md "Trust boundary").
# Locally, leave CHANGE_ME_LOCAL_ONLY: `npm run db:start` / `npm run db:reset`
# generate a random password, store it in .env.local and apply it to the local
# database only (scripts/set-local-db-password.ts). Never reuse it elsewhere.
DATABASE_URL=postgresql://aibab_app:CHANGE_ME_LOCAL_ONLY@127.0.0.1:54322/postgres

# --- Database tests (`npm run test:db`) — local only, never set in hosted envs ---
# Values come from `npx supabase status`.
TEST_DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
TEST_SUPABASE_URL=http://127.0.0.1:54321
TEST_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
TEST_SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# --- Provisioning only (not read by the app) ---
# Password for the `aibab_app` role in hosted environments (Stage 7).
# AIBAB_APP_DB_PASSWORD=

# --- Added in upcoming tasks ---
# Task 3 (Supabase Auth):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
#
# Stage 5 (AI):
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
